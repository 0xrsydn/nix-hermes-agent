+def _make_owner_writable(tree: Path) -> None:
+    """copytree keeps the source's modes, so a plugin installed read-only (a Nix store path) yields a
+    read-only copy: renaming a directory into a new parent needs write access to it, and cleanup needs it to
+    delete the copy. The snapshot is private, so the owner may always write it."""
+    for root, dirs, files in os.walk(tree):
+        for name in [root, *(os.path.join(root, entry) for entry in dirs + files)]:
+            mode = os.lstat(name).st_mode
+            if not stat.S_ISLNK(mode):
+                os.chmod(name, stat.S_IMODE(mode) | stat.S_IWUSR)
+
